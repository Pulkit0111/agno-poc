# Bott configuration — copy to .env and fill in. Loaded by the CLI/server entrypoints.
# Every connector/feature is independent: leave a group blank and it simply stays off.

# ── Required to start + chat in Slack ────────────────────────────────────────────
# Slack (HTTP Events API — needs a public URL for the request URLs; see docs):
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Encryption key for secrets at rest (Codex token, connector tokens). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOTT_SECRET_KEY=

# Admin emails (comma-separated) — gate the skill curator + model overrides. Include yours.
BOTT_ADMINS=

# ── Model (codex-only) ───────────────────────────────────────────────────────────
# Every LLM call — chat, build, review, triage, memory — runs through the official
# `codex` CLI (`codex exec`) on the org ChatGPT subscription. There is no other provider.
# Connect the org login ONCE via the console (Admin → Models → Connect ChatGPT) or by
# running `codex login` with CODEX_HOME pointed at the path below; the CLI owns and
# refreshes the token there. NOTHING else ever touches it (single-refresher rule).
#
# Per-role model ids (the console can override these live). `-codex`-suffixed ids
# (e.g. gpt-5.5-codex) are NOT usable with a ChatGPT-account login — the backend rejects them.
# BOTT_CHAT_MODEL=gpt-5.5     # everyday chat turns
# BOTT_BUILD_MODEL=gpt-5.5    # writes/fixes real code — highest-stakes job
# BOTT_REVIEW_MODEL=gpt-5.5   # reviews PRs — use the STRONGEST model; a weaker reviewer
                              # under-calls real vulns (verified: gpt-5.4 missed SQL
                              # injection, gpt-5.5 flagged it merge-blocking). Same model
                              # as build is fine — anti-affinity was removed.
# BOTT_HEAVY_MODEL=gpt-5.5    # legacy fallback build/review use if their own var is unset
#
# Fairness for the ONE shared login: everyone's requests share the same account, so these
# caps stop a burst of concurrent messages (or one heavy user) from hammering it at once.
# When the shared plan hits its usage window, calls fail with an honest "usage limit" error.
# CODEX_MAX_CONCURRENT_REQUESTS=4   # org-wide cap on simultaneous codex calls
# CODEX_MAX_CONCURRENT_PER_USER=2   # smaller per-user cap so no one user claims every slot
# MODEL_RETRY_DELAY_S=3             # base retry delay in seconds (doubles each attempt)
#
# codex CLI plumbing:
# CODEX_CLI_BIN=codex               # override the binary name/path
# CODEX_CLI_TIMEOUT_S=900           # per build/review codex-exec call
# CODEX_CHAT_TIMEOUT_S=300          # per CHAT turn (a person is waiting in Slack)
# CODEX_HOME=/var/lib/bott/codex    # the dir the codex CLI keeps its login in — THE single
#                                   # auth store; a mounted volume in prod. An org admin
#                                   # logs in ONCE; the CLI refreshes/rotates it in place.
#                                   # Defaults to ~/.codex; use a dedicated path so unrelated
#                                   # tooling can't clear it.
# BOTT_CODEX_DISABLE_SANDBOX=1      # ONLY if the process is already container-confined
#                                   # (bubblewrap needs user namespaces most containers lack)
#
# Chat tools over MCP: chat's toolkits are served to codex exec by bott's own loopback
# MCP server (bearer-ticket auth; started automatically with the app).
# BOTT_MCP_PORT=7801                # loopback port for the MCP chat-tools server
# BOTT_MCP_URL=http://127.0.0.1:7801/mcp   # what codex exec is pointed at
# BOTT_MCP_TICKET_TTL_S=3600        # max age of a per-turn identity ticket

# ── Database ─────────────────────────────────────────────────────────────────────
# Unset = local SQLite (agentos.db), fine for testing. Set for Postgres (production):
# DATABASE_URL=postgresql://user:pass@host:5432/bott

# ── GitHub App (Build & Fix / PR review / triage → draft PRs) ────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=            # path to the .pem (or inline GITHUB_APP_PRIVATE_KEY)
GITHUB_WEBHOOK_SECRET=
ALLOWED_POST_REPOS=                     # comma-separated owner/repo the bot may open PRs on
REVIEW_SLACK_CHANNEL=                   # where webhook auto-reviews mirror

# ── Connectors (all optional, read-only) ─────────────────────────────────────────
# Jira + Confluence (Atlassian API token). Confluence falls back to the Jira creds.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# CONFLUENCE_URL=  CONFLUENCE_USERNAME=  CONFLUENCE_API_KEY=

# Sentry (read + triage):
SENTRY_ORG_SLUG=
SENTRY_API_TOKEN=
# SENTRY_BASE_URL=https://sentry.io     # only if self-hosted

# Google Workspace (Gmail/Drive/Calendar, read-only via domain-wide delegation).
# Admin authorizes the service account for the gmail/drive/calendar .readonly scopes.
GOOGLE_SERVICE_ACCOUNT_PATH=            # path to the service-account JSON key

# Memra (org context layer):
MEMRA_CLIENT_ID=
MEMRA_CLIENT_SECRET=
MEMRA_TOKEN_ENDPOINT=
MEMRA_MCP_ENDPOINT=
MEMRA_SCOPE=

# Spin (publish rendered reports to a hosted URL):
SPIN_API_BASE_URL=
SPIN_API_TOKEN=
SPIN_PUBLIC_ZONE=

# ── Web console (Next.js app in console/, talks to /api/console/*) ───────────────
CONSOLE_SESSION_SECRET=                 # long random string; enables the console API
SLACK_CLIENT_ID=                        # Slack app OpenID Connect (Basic Information)
SLACK_CLIENT_SECRET=
# CONSOLE_BASE_URL=http://localhost:3000  # where the console is served (default shown)

# ── Production deployment (docker-compose.prod.yml) ─────────────────────────────
# BOTT_PORT is honored everywhere (Dockerfile healthcheck, compose wiring, the console's
# proxy target) — set it once here and the whole stack follows. CONSOLE_BASE_URL must be
# the PUBLIC HTTPS URL of your ingress (reverse proxy / tunnel in front of the console),
# not localhost — Slack's OIDC redirect and the console CSRF check derive from it.

# Password for the compose-managed Postgres (user/db are both `bott`). The prod compose
# file refuses to start without it. Generate something long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Bearer key protecting the AgentOS native API (Agno reads this env var and requires
# `Authorization: Bearer <key>` on its built-in routes). The prod compose keeps bott off
# the host network entirely, but set this anyway — defense in depth. Generate long random:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OS_SECURITY_KEY=

# ── Optional (sensible defaults; uncomment to override) ──────────────────────────
# BOTT_HOST=localhost
# BOTT_PORT=7777
# ALLOWED_EMAIL_DOMAIN=axelerant.com
# LOG_LEVEL=INFO
