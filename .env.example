# Bott configuration — copy to .env and fill in. Loaded by the CLI/server entrypoints.
# Every connector/feature is independent: leave a group blank and it simply stays off.

# ── Required to start + chat in Slack ────────────────────────────────────────────
# Slack (HTTP Events API — needs a public URL for the request URLs; see docs):
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Encryption key for secrets at rest (Codex token, connector tokens). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOTT_SECRET_KEY=

# Admin emails (comma-separated) — gate the skill curator + model overrides. Include yours.
BOTT_ADMINS=

# ── Model provider ───────────────────────────────────────────────────────────────
# Default is 'codex' (org ChatGPT/Codex subscription — no key). Connect the org token once:
# either have ~/.codex/auth.json on the host, or paste it via Slack App Home → Connect Codex.
MODEL_PROVIDER=codex
# Per-role PROVIDER + model are chosen in the console (Admin → Models) — e.g. Chat → OpenRouter
# while Build/Review stay on Codex. The vars below are only the CODEX fallbacks used when a job
# runs on Codex; set them explicitly so review doesn't auto-swap off a shared id. `-codex`-suffixed
# ids (e.g. gpt-5.5-codex) are NOT usable with a ChatGPT-account login — the backend rejects them.
# BOTT_CHAT_MODEL=          # chat is configured in the console (OpenRouter), not via env
# BOTT_BUILD_MODEL=gpt-5.5    # writes/fixes real code — highest-stakes job (Codex)
# BOTT_REVIEW_MODEL=gpt-5.4   # deliberately DIFFERENT from build — reviewer must not share
                              # the author's blind spots
# BOTT_HEAVY_MODEL=gpt-5.5    # legacy fallback build/review use if their own var is unset
#
# Fairness for the ONE shared Codex login: everyone's requests share the same account, so
# these caps stop a burst of concurrent messages (or one heavy user) from hammering it at
# once. Sane defaults below; raise MODEL_RETRY_DELAY_S further if you still see 429s.
# CODEX_MAX_CONCURRENT_REQUESTS=4   # org-wide cap on simultaneous Codex calls
# CODEX_MAX_CONCURRENT_PER_USER=2   # smaller per-user cap so no one user claims every slot
# MODEL_RETRY_DELAY_S=3             # base retry delay in seconds (doubles each attempt)
# CODEX_TIMEOUT_S=300               # per-request timeout for Codex calls, in seconds
# Codex CLI-exec (opt-in): route build/review through the official `codex` CLI (`codex exec`)
# as a subprocess instead of the direct Responses adapter — lower ban-risk on the shared
# subscription; engages only for roles whose provider is codex; chat is never affected.
# Requires the `codex` binary on PATH. VERIFY FIRST: `python scripts/eval_codex_cli.py`.
# CODEX_CLI_EXEC=1                  # default off
# CODEX_CLI_BIN=codex               # override the binary name/path
# CODEX_CLI_TIMEOUT_S=900           # per codex-exec call
# CODEX_HOME=/var/lib/bott/codex    # dedicated dir the codex CLI keeps its login (auth.json)
#                                   # in; a mounted volume in prod. An org admin runs
#                                   # `codex login` into it ONCE; the CLI owns/refreshes the
#                                   # token there and all users' build/review calls share it.
#                                   # Defaults to ~/.codex; use a dedicated path so unrelated
#                                   # tooling can't clear it.
# BOTT_CODEX_DISABLE_SANDBOX=1      # ONLY if the process is already container-confined
# For other providers instead of codex:
#   MODEL_PROVIDER=openrouter + OPENROUTER_API_KEY=sk-or-...
#   MODEL_PROVIDER=bedrock     + AWS credentials in the environment
#
# OpenRouter key — needed whenever ANY job runs on OpenRouter. You can now pick the
# provider PER JOB in the console (Admin → Models): e.g. Chat → OpenRouter while Build/
# Review stay on Codex. That per-job choice only works if this key is set. Get one at
# https://openrouter.ai/keys and uncomment:
# OPENROUTER_API_KEY=sk-or-...
#
# Optional: since every LLM call goes through the ONE shared Codex login, if it ever breaks
# (subscription lapsed, refresh failed) every feature fails at once. Set a fallback provider
# to degrade instead — BOTT_ADMINS still gets DM'd either way so someone finds out and
# reconnects it.
# FALLBACK_MODEL_PROVIDER=bedrock   # or openrouter; needs that provider's own creds set too
# FALLBACK_MODEL_ID=anthropic.claude-sonnet-4-6-v1:0   # optional; has a sane default

# ── Database ─────────────────────────────────────────────────────────────────────
# Unset = local SQLite (agentos.db), fine for testing. Set for Postgres (production):
# DATABASE_URL=postgresql://user:pass@host:5432/bott

# ── GitHub App (Build & Fix / PR review / triage → draft PRs) ────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=            # path to the .pem (or inline GITHUB_APP_PRIVATE_KEY)
GITHUB_WEBHOOK_SECRET=
ALLOWED_POST_REPOS=                     # comma-separated owner/repo the bot may open PRs on
REVIEW_SLACK_CHANNEL=                   # where webhook auto-reviews mirror

# ── Connectors (all optional, read-only) ─────────────────────────────────────────
# Jira + Confluence (Atlassian API token). Confluence falls back to the Jira creds.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# CONFLUENCE_URL=  CONFLUENCE_USERNAME=  CONFLUENCE_API_KEY=

# Sentry (read + triage):
SENTRY_ORG_SLUG=
SENTRY_API_TOKEN=
# SENTRY_BASE_URL=https://sentry.io     # only if self-hosted

# Google Workspace (Gmail/Drive/Calendar, read-only via domain-wide delegation).
# Admin authorizes the service account for the gmail/drive/calendar .readonly scopes.
GOOGLE_SERVICE_ACCOUNT_PATH=            # path to the service-account JSON key

# Memra (org context layer):
MEMRA_CLIENT_ID=
MEMRA_CLIENT_SECRET=
MEMRA_TOKEN_ENDPOINT=
MEMRA_MCP_ENDPOINT=
MEMRA_SCOPE=

# Spin (publish rendered reports to a hosted URL):
SPIN_API_BASE_URL=
SPIN_API_TOKEN=
SPIN_PUBLIC_ZONE=

# ── Web console (Next.js app in console/, talks to /api/console/*) ───────────────
CONSOLE_SESSION_SECRET=                 # long random string; enables the console API
SLACK_CLIENT_ID=                        # Slack app OpenID Connect (Basic Information)
SLACK_CLIENT_SECRET=
# CONSOLE_BASE_URL=http://localhost:3000  # where the console is served (default shown)

# ── Production deployment (docker-compose.prod.yml) ─────────────────────────────
# BOTT_PORT is honored everywhere (Dockerfile healthcheck, compose wiring, the console's
# proxy target) — set it once here and the whole stack follows. CONSOLE_BASE_URL must be
# the PUBLIC HTTPS URL of your ingress (reverse proxy / tunnel in front of the console),
# not localhost — Slack's OIDC redirect and the console CSRF check derive from it.

# Password for the compose-managed Postgres (user/db are both `bott`). The prod compose
# file refuses to start without it. Generate something long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Bearer key protecting the AgentOS native API (Agno reads this env var and requires
# `Authorization: Bearer <key>` on its built-in routes). The prod compose keeps bott off
# the host network entirely, but set this anyway — defense in depth. Generate long random:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OS_SECURITY_KEY=

# ── Optional (sensible defaults; uncomment to override) ──────────────────────────
# BOTT_HOST=localhost
# BOTT_PORT=7777
# ALLOWED_EMAIL_DOMAIN=axelerant.com
# LOG_LEVEL=INFO
