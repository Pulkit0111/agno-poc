# Secrets — never commit
.env
deploy-credentials.env
.secrets/
*.pem

# Runtime state
*.db
*.db-shm
*.db-wal
*.log

# Agentic workspace (sandboxed scratch for file/terminal/code tools)
.bott_workspace/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# agent-ui (Phase 4 scaffold) — separate Next.js repo, excluded for now
agent-ui/

# Local tooling / harness state
.claude/
.superpowers/
# Local design/plan docs (not tracked) — EXCEPT the operationally load-bearing ones below.
# The rest of docs/ (architecture notes, specs) is fine to lose to a wiped laptop; the
# go-live setup guide and test scenarios are not — they're the only copy of that knowledge
# and must survive via `git clone` alone, not one person's machine.
docs/*
!docs/SETUP.md
!docs/TEST-SCENARIOS.md
agentos.db
agentos.db-*

temp.md